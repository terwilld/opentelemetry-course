# Development Dockerfile with hot-reload support
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY pyproject.toml ./

# Install PyTorch, dependencies and dev tools from UKG Artifactory.
# Token is passed as a BuildKit secret (--secret id=art,src=...) so it is not stored in the image.
RUN --mount=type=secret,id=art \
    export PIP_INDEX_URL="https://david.terwilliger%40ukg.com:$(cat /run/secrets/art)@ukgartifactory.pe.jfrog.io/artifactory/api/pypi/pypi/simple" && \
    pip install --no-cache-dir torch && \
    pip install --no-cache-dir . && \
    pip install --no-cache-dir watchdog

# Download Argos Translate models (will be cached in volume)
COPY download_models.py ./
RUN python download_models.py

# Source code will be mounted as volume

# Set Python path
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Default command runs worker (no auto-reload by default)
# Use compose.dev.yml for watchdog-based reload
CMD ["python", "-m", "src.main"]
